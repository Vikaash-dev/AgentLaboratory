# =============================================================================
# AgentLaboratory Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit your .env file with real keys to version control.
# =============================================================================

# OpenAI API Key (required for GPT models)
# OPENAI_API_KEY=your-openai-api-key-here

# DeepSeek API Key (alternative to OpenAI)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Google Gemini API Key (for Gemini models including gemini-3-pro)
# GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Tavily API Key (for web search capabilities)
# TAVILY_API_KEY=your-tavily-api-key-here

# Kaggle API Token (for dataset access and notebook submission)
# Obtain from https://www.kaggle.com/settings -> API -> Create New Token
# KAGGLE_API_TOKEN=your-kaggle-api-token-here

# =============================================================================
# Compute Configuration
# =============================================================================
# Set to "cpu" for local testing without GPU, or "gpu" for GPU-accelerated runs
# COMPUTE_MODE=cpu
